  "closing.title": "\u6709\u60f3\u6cd5\uff1f\n\u8bf4\u51fa\u6765\u3002",
  "closing.release": "\u7248\u672c\u8bf4\u660e",
  "closing.pip": "\u5c0f\u5c0f\u4e00\u53ea\uff0c\u8ba4\u771f\u542c\u4f60\u8bf4\u3002",
  "footer.note": "\u7531 x2x3studio \u5236\u4f5c\uff0c\u4e3a\u4f60\u7684 Mac \u800c\u505a\u3002",
  "footer.nav": "\u9875\u811a\u5bfc\u822a",
  "footer.guide": "\u7528\u6237\u6307\u5357",
  "footer.top": "\u56de\u5230\u9876\u90e8 \u2191",
  "meta.title": "Talkless \u2014 \u968f\u53e3\u4e00\u8bf4\uff0c\u6587\u5b57\u5c31\u5728\u5149\u6807\u8eab\u65c1\u3002",
  "meta.description": "\u8bf4\u51fa\u6765\uff0c\u6587\u5b57\u5c31\u51fa\u73b0\u5728\u4f60\u6b63\u5728\u8f93\u5165\u7684\u5730\u65b9\u3002Talkless \u662f\u4e00\u6b3e\u5b89\u9759\u3001\u672c\u5730\u4f18\u5148\u7684 Mac \u8bed\u97f3\u8f93\u5165\u5e94\u7528\uff0c\u9002\u7528\u4e8e Apple Silicon \u548c macOS 26+\u3002",
  "demo.sentence": "\u8ba9 Talkless \u518d\u5b89\u9759\u4e00\u70b9\u5427\u3002\u7ed9\u6587\u5b57\u591a\u7559\u4e9b\u7a7a\u95f4\uff0c\u5c11\u4e00\u70b9\u6253\u6270\u3002",
  "demo.started": "\u6b63\u5728\u64ad\u653e\u6a21\u62df\u8bed\u97f3\u8f93\u5165\uff0c\u4e0d\u4f1a\u5f55\u97f3\u3002",
  "demo.finished": "\u6f14\u793a\u5b8c\u6210\uff0c\u793a\u4f8b\u6587\u5b57\u5df2\u5199\u5165\u53ef\u7f16\u8f91\u7684\u7b14\u8bb0\u3002",
  "demo.cancelled": "\u6f14\u793a\u5df2\u53d6\u6d88\u3002",
  "demo.replay": "\u518d\u64ad\u653e\u4e00\u6b21",
  "demo.keepNote": "\u5df2\u4fdd\u7559\u4f60\u7f16\u8f91\u7684\u7b14\u8bb0\u3002\u6e05\u7a7a\u7b14\u8bb0\u540e\uff0c\u53ef\u4ee5\u91cd\u65b0\u64ad\u653e\u6f14\u793a\u3002",
  "nav.support": "\u5e2e\u52a9",
  "nav.home": "\u8fd4\u56de Talkless",
  "docs.onPage": "\u672c\u9875\u5185\u5bb9",
  "docs.more": "\u7ee7\u7eed\u4e86\u89e3",
  "guide.meta.title": "\u7528\u6237\u6307\u5357 \u2014 Talkless",
  "guide.meta.description": "\u5b89\u88c5 Talkless\uff0c\u914d\u7f6e\u672c\u5730\u8bed\u97f3\u8bc6\u522b\uff0c\u4e86\u89e3\u542c\u5199\u3001\u6da6\u8272\u548c\u7ffb\u8bd1\u7684\u64cd\u4f5c\u65b9\u5f0f\u3002",
  "guide.eyebrow": "\u4ece\u7b2c\u4e00\u6b21\u5f00\u53e3\u5f00\u59cb",
  "guide.title": "\u4ece\u4e00\u4e2a\u5ff5\u5934\uff0c\n\u5230\u4e00\u884c\u6587\u5b57\u3002",
  "guide.intro": "\u5148\u7528\u672c\u5730\u542c\u5199\u3002\u9700\u8981\u65f6\uff0c\u518d\u6dfb\u52a0\u4e91\u7aef\u8bed\u97f3\u6216 AI \u670d\u52a1\u3002\u65e0\u9700\u6ce8\u518c Talkless \u8d26\u53f7\u3002",
  "guide.install.title": "\u5b89\u88c5\u4e0e\u51c6\u5907",
  "guide.install.first": "\u8bf7\u4f7f\u7528\u642d\u8f7d Apple Silicon \u82af\u7247\u3001\u8fd0\u884c macOS 26 \u6216\u66f4\u65b0\u7248\u672c\u7684 Mac\u3002\u4e0b\u8f7d Beta \u7248\uff0c\u6253\u5f00 DMG\uff0c\u5c06 Talkless \u62d6\u5165\u201c\u5e94\u7528\u7a0b\u5e8f\u201d\uff0c\u518d\u6253\u5f00\u8be5\u526f\u672c\u3002",
  "guide.install.permissions": "\u6309\u7167\u8bbe\u7f6e\u5411\u5bfc\u6388\u4e88\u9ea6\u514b\u98ce\u548c\u8f85\u52a9\u529f\u80fd\u6743\u9650\u3002\u9ea6\u514b\u98ce\u7528\u4e8e\u5f55\u97f3\uff0c\u8f85\u52a9\u529f\u80fd\u7528\u4e8e\u5feb\u6377\u952e\u548c\u6587\u5b57\u63d2\u5165\u3002\u8df3\u8fc7\u5411\u5bfc\u4e0d\u4f1a\u81ea\u52a8\u6388\u4e88\u6743\u9650\u3002",
  "guide.install.model": "\u5728\u201c\u8bbe\u7f6e \u2192 \u8bed\u97f3\u8bc6\u522b\u201d\u4e0b\u8f7d\u672c\u5730 Qwen3 ASR \u00b7 0.6B \u6a21\u578b\uff08\u7ea6 713 MB\uff09\uff0c\u7b49\u5f85\u6821\u9a8c\u548c\u51c6\u5907\u5b8c\u6210\u3002\u6a21\u578b\u6587\u4ef6\u4e0e\u5e94\u7528\u5206\u5f00\u4e0b\u8f7d\uff0c\u4e0d\u7531 Talkless \u6258\u7ba1\u3002",
  "guide.shortcuts.title": "\u8bf4\u8bdd\u4e0e\u5b8c\u6210\u8f93\u5165",
  "guide.shortcuts.body": "\u70b9\u51fb\u8f93\u5165\u6846\uff0c\u6309\u4f4f Fn \u8bf4\u8bdd\uff0c\u677e\u5f00\u540e\u5b8c\u6210\u3002\u4e5f\u53ef\u5728\u201c\u8bbe\u7f6e \u2192 \u542c\u5199\u201d\u6539\u4e3a\u70b9\u6309\u5207\u6362\u6a21\u5f0f\u3002\u8bf4\u8bdd\u505c\u987f\u4e0d\u4f1a\u81ea\u52a8\u7ed3\u675f\u5f55\u97f3\uff1bEscape \u53ef\u53d6\u6d88\u5f55\u97f3\u6216\u5904\u7406\u3002",
  "guide.shortcuts.focus": "\u8bf7\u5728\u7ed3\u679c\u51fa\u73b0\u524d\u4fdd\u6301\u76ee\u6807\u8f93\u5165\u6846\u7684\u7126\u70b9\u3002Talkless \u901a\u8fc7\u526a\u8d34\u677f\u5728\u5f53\u524d\u5149\u6807\u5904\u7c98\u8d34\uff0c\u968f\u540e\u6062\u590d\u539f\u526a\u8d34\u677f\u5185\u5bb9\uff08\u9664\u975e\u4f60\u5df2\u590d\u5236\u4e86\u5176\u4ed6\u5185\u5bb9\uff09\u3002\u9700\u8981\u65f6\uff0c\u53ef\u4ece\u5386\u53f2\u8bb0\u5f55\u627e\u56de\u5df2\u5b8c\u6210\u7684\u6587\u5b57\u3002",
  "guide.shortcuts.keys": "Fn \u53ea\u662f\u9ed8\u8ba4\u6309\u952e\u3002\u4f60\u53ef\u4ee5\u5728\u542c\u5199\u8bbe\u7f6e\u4e2d\u4fee\u6539\u542c\u5199\u952e\u548c AI \u6da6\u8272\u5feb\u6377\u952e\u3002\u5982\u679c Fn \u6253\u5f00\u8868\u60c5\u9762\u677f\uff0c\u8bf7\u5c06 macOS \u952e\u76d8\u8bbe\u7f6e\u4e2d\u7684\u5730\u7403\u4eea\u6309\u952e\u64cd\u4f5c\u6539\u4e3a\u201c\u4e0d\u6267\u884c\u4efb\u4f55\u64cd\u4f5c\u201d\uff0c\u6216\u9009\u62e9\u5176\u4ed6\u6309\u952e\u3002",
  "guide.speech.title": "\u9009\u62e9\u8bed\u97f3\u8bc6\u522b\u65b9\u5f0f",
  "guide.speech.body": "\u672c\u5730 Qwen \u548c Apple \u8bbe\u5907\u7aef\u8bc6\u522b\u5728\u6240\u9700\u6a21\u578b\u51c6\u5907\u597d\u540e\u53ef\u79bb\u7ebf\u5de5\u4f5c\uff0c\u5e76\u63d0\u4f9b\u5b9e\u65f6\u6587\u5b57\u3002\u517c\u5bb9 Whisper \u7684\u4e91\u7aef\u8bc6\u522b\u4f1a\u5728\u5f55\u97f3\u7ed3\u675f\u540e\uff0c\u5c06\u5b8c\u6574\u97f3\u9891\u53d1\u9001\u7ed9\u4f60\u914d\u7f6e\u7684\u670d\u52a1\u5546\uff0c\u53ef\u80fd\u4ea7\u751f\u8d39\u7528\u3002",
  "guide.speech.mic": "\u5728\u201c\u8bbe\u7f6e \u2192 \u542c\u5199\u201d\u4e2d\u9009\u62e9\u7cfb\u7edf\u9ed8\u8ba4\u6216\u6307\u5b9a\u9ea6\u514b\u98ce\u3002\u6307\u5b9a\u9ea6\u514b\u98ce\u65ad\u5f00\u65f6\uff0c\u4e0d\u4f1a\u9759\u9ed8\u5207\u6362\u5230\u5176\u4ed6\u8bbe\u5907\u3002\u5f55\u97f3\u9014\u4e2d\u8f93\u5165\u8def\u7531\u53d8\u5316\u65f6\uff0c\u8bf7\u68c0\u67e5\u8bbe\u5907\u540e\u91cd\u65b0\u5f00\u59cb\u3002",
  "guide.ai.title": "\u9700\u8981\u65f6\u518d\u4f7f\u7528 AI",
  "guide.ai.body": "\u5728\u201c\u8bbe\u7f6e \u2192 AI \u670d\u52a1\u201d\u914d\u7f6e\u4f60\u81ea\u5df1\u7684\u670d\u52a1\u5546\u3001\u51ed\u636e\u548c\u6a21\u578b\u3002\u6da6\u8272\u9ed8\u8ba4\u5173\u95ed\u3002\u5f55\u97f3\u65f6\uff0cAI \u6da6\u8272\u5feb\u6377\u952e\uff08\u9ed8\u8ba4\u4e3a\u53f3 Option\uff09\u4f1a\u7ed3\u675f\u672c\u6b21\u8f93\u5165\uff0c\u5e76\u6267\u884c\u4e0e\u9ed8\u8ba4\u6da6\u8272\u8bbe\u7f6e\u76f8\u53cd\u7684\u52a8\u4f5c\uff1a\u201c\u4f7f\u7528 AI \u6da6\u8272\u201d\u6216\u201c\u8df3\u8fc7 AI \u6da6\u8272\u201d\u3002\u5b83\u4e0d\u4f1a\u4fee\u6539\u9ed8\u8ba4\u8bbe\u7f6e\u3002",
  "guide.ai.more": "\u8bed\u97f3\u7f16\u8f91\u9700\u5728\u542c\u5199\u8bbe\u7f6e\u4e2d\u5355\u72ec\u542f\u7528\uff1a\u9009\u4e2d\u6587\u5b57\uff0c\u518d\u8bf4\u51fa\u4fee\u6539\u6307\u4ee4\u3002\u7ffb\u8bd1\u9ed8\u8ba4\u4f7f\u7528 Control-Option-T\uff1a\u9009\u4e2d\u6587\u5b57\uff0c\u67e5\u770b\u7ed3\u679c\uff0c\u518d\u9009\u62e9\u590d\u5236\u6216\u66ff\u6362\u539f\u6587\u3002\u8fd9\u4e9b\u529f\u80fd\u4f1a\u5c06\u6240\u9700\u6587\u5b57\u53d1\u9001\u7ed9\u4f60\u7684 AI \u670d\u52a1\u5546\uff1b\u8bf7\u6838\u5bf9\u8f93\u51fa\u540e\u518d\u4f7f\u7528\u3002",
  "guide.dictionary.title": "\u7559\u4e0b\u5e38\u7528\u8bcd\u548c\u6709\u7528\u7684\u7ed3\u679c",
  "guide.dictionary.body": "\u5728\u201c\u8bbe\u7f6e \u2192 \u8bcd\u5178\u201d\u6dfb\u52a0\u504f\u597d\u7684\u62fc\u5199\u3002\u84dd\u8272\u8bcd\u5178\u6807\u8bb0\u8868\u793a\u5df2\u786e\u8ba4\u7684\u5199\u6cd5\u51fa\u73b0\u5728\u6587\u5b57\u4e2d\uff0c\u4e0d\u4fdd\u8bc1\u5df2\u7ecf\u7ea0\u9519\u3002\u5f85\u5ba1\u6838\u5efa\u8bae\u6765\u81ea\u672c\u5730\u539f\u6587\u4e0e\u6da6\u8272\u5386\u53f2\u7684\u6bd4\u8f83\uff1b\u53ea\u6709\u4f60\u63a5\u53d7\u7684\u8bcd\u6761\u624d\u4f1a\u52a0\u5165\u8bcd\u5178\u3002",
  "guide.dictionary.history": "\u5386\u53f2\u8bb0\u5f55\u5728 Mac \u4e0a\u4fdd\u7559\u6700\u8fd1\u6700\u591a 500 \u6761\u7ed3\u679c\uff0c\u53ef\u590d\u5236\u6216\u5220\u9664\u3002\u6e05\u9664\u5386\u53f2\u4e0e\u6e05\u9664\u6bcf\u65e5\u6d3b\u52a8\u662f\u4e24\u4e2a\u72ec\u7acb\u64cd\u4f5c\u3002\u754c\u9762\u8bed\u8a00\u3001\u8bc6\u522b\u8bed\u8a00\u548c AI \u8f93\u51fa\u8bed\u8a00\u4e5f\u5206\u522b\u8bbe\u7f6e\u3002",
  "privacy.meta.title": "\u9690\u79c1 \u2014 Talkless",
  "privacy.meta.description": "\u4e86\u89e3\u54ea\u4e9b\u6570\u636e\u7559\u5728 Mac \u4e0a\u3001\u53ef\u9009\u670d\u52a1\u5546\u4f1a\u6536\u5230\u4ec0\u4e48\uff0c\u4ee5\u53ca Talkless \u5982\u4f55\u4fdd\u5b58\u51ed\u636e\u3001\u5386\u53f2\u8bb0\u5f55\u548c\u8bca\u65ad\u4fe1\u606f\u3002",
  "privacy.page.eyebrow": "\u6570\u636e\u53bb\u5411\uff0c\u8bf4\u660e\u767d",
  "privacy.page.title": "\u9ed8\u8ba4\u7559\u5728\u672c\u5730\u3002\n\u5176\u4ed6\u53bb\u5411\uff0c\u4e5f\u8bf4\u6e05\u695a\u3002",
  "privacy.page.intro": "\u672c\u5730\u4f18\u5148\u4e0d\u4ee3\u8868\u6240\u6709\u529f\u80fd\u90fd\u79bb\u7ebf\u3002\u4e0b\u9762\u8bf4\u660e\u5e94\u7528\u548c\u672c\u7f51\u7ad9\u5982\u4f55\u5904\u7406\u6570\u636e\u3002",
  "privacy.audio.title": "\u8bed\u97f3\u4e0e\u6a21\u578b\u4e0b\u8f7d",
  "privacy.audio.body": "\u672c\u5730 Qwen \u5728 Mac \u4e0a\u5904\u7406\u97f3\u9891\uff1bApple \u8bc6\u522b\u5728\u6240\u9700\u8d44\u6e90\u51c6\u5907\u597d\u540e\u4e8e\u8bbe\u5907\u7aef\u8fd0\u884c\u3002\u4e0b\u8f7d\u6a21\u578b\u4f1a\u8fde\u63a5\u4f60\u9009\u62e9\u7684\u6a21\u578b\u6765\u6e90\uff0cTalkless \u4e0d\u6258\u7ba1\u6a21\u578b\u6743\u91cd\u3002\u53ef\u9009\u7684\u4e91\u7aef\u8bc6\u522b\u4f1a\u5c06\u5b8c\u6574\u5f55\u97f3\u548c\u8bcd\u5178\u63d0\u793a\u4e0a\u4f20\u7ed9\u8bed\u97f3\u670d\u52a1\u5546\u3002",
  "privacy.requests.title": "\u53ef\u9009 AI \u8bf7\u6c42",
  "privacy.requests.body": "\u6da6\u8272\u4f1a\u53d1\u9001\u8f6c\u5199\u6587\u672c\u3001\u8bcd\u5178\u63d0\u793a\u548c\u7f16\u8f91\u6307\u4ee4\uff1b\u542f\u7528\u5e94\u7528\u611f\u77e5\u8bed\u6c14\u65f6\uff0c\u4e5f\u53ef\u80fd\u5305\u542b\u524d\u53f0\u5e94\u7528\u53ca\u5176\u5199\u4f5c\u573a\u666f\u3002\u4f60\u8bbe\u7f6e\u7684\u9644\u52a0\u6307\u4ee4\u548c\u8f93\u51fa\u8bed\u8a00\u4e5f\u4f1a\u968f\u8bf7\u6c42\u53d1\u9001\u3002\u8bed\u97f3\u7f16\u8f91\u53d1\u9001\u9009\u4e2d\u6587\u5b57\u4e0e\u53e3\u8ff0\u6307\u4ee4\uff1b\u7ffb\u8bd1\u53d1\u9001\u9009\u4e2d\u6587\u5b57\u4e0e\u8bed\u8a00\u6307\u4ee4\u3002",
  "privacy.requests.choice": "\u6253\u5f00 AI \u8bbe\u7f6e\u4e0d\u4f1a\u53d1\u9001\u4f60\u7684\u6587\u5b57\u3002\u201c\u83b7\u53d6\u6a21\u578b\u201d\u548c\u201c\u6d4b\u8bd5\u8fde\u63a5\u201d\u662f\u660e\u786e\u7684\u8054\u7f51\u64cd\u4f5c\uff1b\u8fde\u63a5\u6d4b\u8bd5\u4f7f\u7528\u56fa\u5b9a\u793a\u4f8b\uff0c\u4e0d\u4f7f\u7528\u4f60\u7684\u542c\u5199\u5185\u5bb9\u3002\u670d\u52a1\u5546\u7684\u5b9a\u4ef7\u3001\u5904\u7406\u65b9\u5f0f\u548c\u4fdd\u7559\u653f\u7b56\u9002\u7528\uff0cTalkless \u65e0\u6cd5\u4fdd\u8bc1\u670d\u52a1\u5546\u7684\u9690\u79c1\u884c\u4e3a\u3002",
  "privacy.storage.title": "\u5386\u53f2\u8bb0\u5f55\u4e0e\u51ed\u636e",
  "privacy.storage.body": "\u504f\u597d\u8bbe\u7f6e\u4e0e\u8bcd\u5178\u8bcd\u6761\u4f7f\u7528 macOS UserDefaults \u4fdd\u5b58\u3002AI \u670d\u52a1\u5bc6\u94a5\u4f7f\u7528 macOS \u94a5\u5319\u4e32\u3002\u8bf7\u6ce8\u610f\uff1a\u72ec\u7acb\u7684\u4e91\u7aef\u8bed\u97f3\u8bc6\u522b\u5bc6\u94a5\u76ee\u524d\u4ee5\u660e\u6587\u4fdd\u5b58\u5728 UserDefaults \u4e2d\uff0c\u800c\u975e\u94a5\u5319\u4e32\u3002",
  "privacy.storage.history": "\u6a21\u578b\u3001\u6587\u5b57\u5386\u53f2\u3001\u4e0d\u542b\u6587\u672c\u7684\u6bcf\u65e5\u7edf\u8ba1\u548c\u8bca\u65ad\u4fe1\u606f\u4fdd\u5b58\u5728 Mac \u7684 Library/Application Support/Talkless \u6587\u4ef6\u5939\u3002\u5386\u53f2\u8bb0\u5f55\u5305\u542b\u6587\u5b57\u800c\u975e\u97f3\u9891\uff0c\u6700\u591a\u4fdd\u7559 500 \u6761\u7ed3\u679c\u3002\u8bf7\u5728\u5386\u53f2\u8bb0\u5f55\u4e2d\u5220\u9664\u6587\u5b57\uff0c\u5e76\u5355\u72ec\u6e05\u9664\u6bcf\u65e5\u6d3b\u52a8\uff1b\u6bcf\u65e5\u7edf\u8ba1\u4fdd\u7559 400 \u4e2a\u81ea\u7136\u65e5\u3002",
  "privacy.diagnostics.title": "\u7531\u4f60\u51b3\u5b9a\u5206\u4eab\u7684\u8bca\u65ad\u4fe1\u606f",
  "privacy.diagnostics.body": "\u4e8b\u4ef6\u65e5\u5fd7\u603b\u91cf\u9650\u5236\u4e3a 15 MB\uff0c\u4e0d\u542b\u97f3\u9891\u3001\u8f6c\u5199\u6587\u5b57\u3001API \u5bc6\u94a5\u548c\u63d0\u793a\u8bcd\u3002\u5bfc\u51fa\u8bca\u65ad\u53ea\u4f1a\u751f\u6210\u672c\u5730 ZIP\uff0c\u4e0d\u4f1a\u4e0a\u4f20\u3002\u53ef\u9009\u7684 macOS \u5d29\u6e83\u62a5\u544a\u53ef\u80fd\u5305\u542b\u4e2a\u4eba\u4fe1\u606f\u548c\u6587\u4ef6\u8def\u5f84\uff0c\u5206\u4eab\u524d\u8bf7\u68c0\u67e5\u5185\u5bb9\u3002",
  "privacy.website.title": "\u672c\u7f51\u7ad9\u4e0e\u5e94\u7528\u5206\u53d1",
  "privacy.website.body": "\u5e94\u7528\u4e0d\u6536\u96c6\u9065\u6d4b\u6570\u636e\u3002\u672c\u7f51\u7ad9\u6ca1\u6709\u5206\u6790\u6216\u8ffd\u8e2a\u811a\u672c\u3001\u8fdc\u7a0b\u5b57\u4f53\uff0c\u4e5f\u4e0d\u8bbf\u95ee\u9ea6\u514b\u98ce\uff1b\u6258\u7ba1\u670d\u52a1\u53ef\u80fd\u4fdd\u7559\u5e38\u89c4\u8bf7\u6c42\u65e5\u5fd7\u3002\u6f14\u793a\u4f7f\u7528\u6d4f\u89c8\u5668\u5185\u7684\u793a\u4f8b\u6587\u5b57\uff1b\u6d4f\u89c8\u5668\u5141\u8bb8\u65f6\uff0c\u8bed\u8a00\u504f\u597d\u4f1a\u4fdd\u5b58\u5728\u672c\u5730\u3002",
  "privacy.website.download": "\u4e0b\u8f7d\u6309\u94ae\u4f7f\u7528\u672c\u7ad9 /download \u5730\u5740\uff0c\u518d\u8df3\u8f6c\u81f3\u5df2\u53d1\u5e03\u7684 GitHub \u5b89\u88c5\u5305\u3002\u8be5\u4e0b\u8f7d\u7531 GitHub \u6309\u5176\u81ea\u8eab\u653f\u7b56\u5904\u7406\u3002Talkless \u4ee3\u7801\u516c\u5f00\uff0c\u53ef\u901a\u8fc7\u9875\u9996\u552f\u4e00\u7684 GitHub \u5165\u53e3\u67e5\u770b\u4ed3\u5e93\u3002\u201c\u4ee3\u7801\u516c\u5f00\u201d\u4e0d\u7b49\u4e8e\u6388\u4e88\u8f6f\u4ef6\u8bb8\u53ef\u3002",
  "updates.meta.title": "\u7248\u672c\u8bf4\u660e \u2014 Talkless",
  "updates.meta.description": "\u4e86\u89e3\u53ef\u4e0b\u8f7d Talkless Beta \u7248\u7684\u53d8\u5316\uff0c\u4ee5\u53ca\u5982\u4f55\u68c0\u67e5\u66f4\u65b0\u3002",
  "updates.eyebrow": "\u5c0f\u5c0f\u5e94\u7528\uff0c\u6301\u7eed\u6539\u8fdb",
  "updates.title": "Talkless \u7684\n\u65b0\u53d8\u5316\u3002",
  "updates.intro": "\u4ee5\u4e0b\u8bf4\u660e\u5bf9\u5e94\u4e0b\u8f7d\u6309\u94ae\u63d0\u4f9b\u7684\u5df2\u53d1\u5e03 Beta \u7248\uff0c\u4e0d\u662f\u5c1a\u672a\u53d1\u5e03\u7684\u9884\u89c8\u3002",
  "updates.current.title": "\u5f53\u524d Beta \u7248",
  "updates.build": "\u6784\u5efa\u53f7",
  "updates.changed.title": "\u672c\u6b21\u53d8\u5316",
  "updates.install.title": "\u5b89\u88c5\u6216\u66f4\u65b0",
  "updates.install.body": "\u4e0b\u8f7d\u5305\u662f\u7ecf\u8fc7 Developer ID \u7b7e\u540d\u548c\u516c\u8bc1\u7684\u78c1\u76d8\u6620\u50cf\uff0c\u9002\u7528\u4e8e Apple Silicon \u548c macOS 26+\u3002\u6253\u5f00\u540e\u5c06 Talkless \u62d6\u5165\u201c\u5e94\u7528\u7a0b\u5e8f\u201d\u3002\u5df2\u5b89\u88c5\u65f6\uff0c\u53ef\u4ece\u83dc\u5355\u680f\u83dc\u5355\u9009\u62e9\u201c\u68c0\u67e5\u66f4\u65b0\u201d\uff0c\u7531\u4f60\u51b3\u5b9a\u4f55\u65f6\u4e0b\u8f7d\u548c\u5b89\u88c5\u3002",
  "updates.beta.title": "\u5173\u4e8e Beta \u7248",
  "updates.beta.body": "Beta \u7248\u53ef\u80fd\u4ecd\u6709\u4e0d\u5b8c\u5584\u4e4b\u5904\u3002\u66f4\u65b0\u68c0\u67e5\u9075\u5faa\u4f60\u9009\u62e9\u7684\u7a33\u5b9a\u7248\u6216 Beta \u901a\u9053\uff1b\u5207\u56de\u7a33\u5b9a\u7248\u4e0d\u4f1a\u5c06\u5df2\u5b89\u88c5\u7684 Beta \u964d\u7ea7\u3002\u8bed\u97f3\u6a21\u578b\u5355\u72ec\u4e0b\u8f7d\uff0c\u4e0d\u5305\u542b\u5728\u5e94\u7528\u66f4\u65b0\u4e2d\u3002",
  "support.meta.title": "\u5e2e\u52a9 \u2014 Talkless",
  "support.meta.description": "\u6392\u67e5\u6743\u9650\u3001\u8bed\u97f3\u6a21\u578b\u3001\u6587\u5b57\u63d2\u5165\u548c AI \u8fde\u63a5\u95ee\u9898\uff0c\u4e86\u89e3\u5982\u4f55\u63d0\u4f9b\u6709\u7528\u7684 Talkless \u95ee\u9898\u53cd\u9988\u3002",
  "support.eyebrow": "\u9047\u5230\u95ee\u9898\u65f6",
  "support.title": "\u8ba9\u6587\u5b57\uff0c\n\u7ee7\u7eed\u8ddf\u4e0a\u4f60\u3002",
  "support.intro": "\u5148\u8bd5\u8bd5\u4e0b\u9762\u7684\u68c0\u67e5\u65b9\u6cd5\uff0c\u8986\u76d6\u542c\u5199\u65e0\u6cd5\u5f00\u59cb\u6216\u6587\u5b57\u6ca1\u6709\u8fdb\u5165\u8f93\u5165\u6846\u65f6\u7684\u5e38\u89c1\u539f\u56e0\u3002",
  "support.recording.title": "\u65e0\u6cd5\u5f00\u59cb\u5f55\u97f3",
  "support.recording.body": "\u68c0\u67e5 macOS\u201c\u9690\u79c1\u4e0e\u5b89\u5168\u6027\u201d\u4e2d\u7684\u9ea6\u514b\u98ce\u548c\u8f85\u52a9\u529f\u80fd\u6743\u9650\uff0c\u6309\u7cfb\u7edf\u63d0\u793a\u91cd\u65b0\u6253\u5f00 Talkless\u3002\u5728\u542c\u5199\u8bbe\u7f6e\u4e2d\u786e\u8ba4\u6240\u9009\u9ea6\u514b\u98ce\u5df2\u8fde\u63a5\uff0c\u6216\u5c1d\u8bd5\u7cfb\u7edf\u9ed8\u8ba4\u53ca\u5176\u4ed6\u53ef\u7528\u8f93\u5165\u3002\u8bbe\u5907\u65ad\u5f00\u6216\u8def\u7531\u53d8\u5316\u540e\uff0c\u8bf7\u91cd\u65b0\u5f55\u97f3\u3002",
  "support.model.title": "\u6a21\u578b\u5c1a\u672a\u51c6\u5907\u597d",
  "support.model.body": "\u6253\u5f00\u201c\u8bbe\u7f6e \u2192 \u8bed\u97f3\u8bc6\u522b\u201d\uff0c\u7b49\u5f85\u4e0b\u8f7d\u6821\u9a8c\u4e0e\u51c6\u5907\u5b8c\u6210\uff0c\u6216\u91cd\u8bd5\u5931\u8d25\u7684\u4e0b\u8f7d\u3002\u5982\u679c\u7f51\u7edc\u65e0\u6cd5\u8bbf\u95ee\u6240\u9009\u6765\u6e90\uff0c\u53ef\u9009\u62e9\u5176\u4ed6\u652f\u6301\u7684\u955c\u50cf\u3002\u4f7f\u7528 Apple \u8bc6\u522b\u65f6\uff0c\u8bf7\u68c0\u67e5\u6240\u9009\u8bed\u8a00\u53ca\u5176\u8bed\u97f3\u8d44\u6e90\u3002",
  "support.text.title": "\u6587\u5b57\u6ca1\u6709\u51fa\u73b0\uff0c\u6216\u51fa\u73b0\u5728\u522b\u5904",
  "support.text.body": "\u8bf7\u5728\u5904\u7406\u5b8c\u6210\u524d\u4fdd\u6301\u76ee\u6807\u8f93\u5165\u6846\u7684\u7126\u70b9\u3002\u68c0\u67e5\u5386\u53f2\u8bb0\u5f55\u4e2d\u662f\u5426\u6709\u5df2\u5b8c\u6210\u7ed3\u679c\uff0c\u518d\u590d\u5236\u4e00\u6b21\u3002\u90e8\u5206\u5e94\u7528\u4f1a\u9650\u5236\u7c98\u8d34\u6216\u9009\u4e2d\u6587\u5b57\u7684\u8bfb\u53d6\u3002\u53ef\u5c1d\u8bd5\u5728\u5907\u5fd8\u5f55\u7684\u666e\u901a\u8f93\u5165\u533a\u57df\u542c\u5199\uff0c\u5224\u65ad\u662f\u5426\u4ec5\u5728\u67d0\u4e2a\u5e94\u7528\u4e2d\u51fa\u73b0\u95ee\u9898\u3002",
  "support.ai.title": "AI \u65e0\u6cd5\u4f7f\u7528",
  "support.ai.body": "\u5728 AI \u670d\u52a1\u8bbe\u7f6e\u4e2d\u68c0\u67e5\u670d\u52a1\u5546\u3001\u5bc6\u94a5\u548c\u6a21\u578b\u3002\u201c\u914d\u7f6e\u5b8c\u6210\u201d\u4e0d\u4ee3\u8868\u5df2\u7ecf\u6210\u529f\u8fde\u63a5\u3002\u201c\u6d4b\u8bd5\u8fde\u63a5\u201d\u4f1a\u53d1\u9001\u56fa\u5b9a\u793a\u4f8b\uff0c\u53ef\u80fd\u4ea7\u751f\u670d\u52a1\u5546\u8d39\u7528\u3002\u6da6\u8272\u5931\u8d25\u65f6\u4fdd\u7559\u539f\u59cb\u8f6c\u5199\uff1b\u7ffb\u8bd1\u548c\u8bed\u97f3\u7f16\u8f91\u4f1a\u663e\u793a\u5404\u81ea\u7684\u9519\u8bef\u3002\u95ee\u9898\u53cd\u9988\u4e2d\u5207\u52ff\u5206\u4eab API \u5bc6\u94a5\u3002",
  "support.report.title": "\u53cd\u9988\u53ef\u590d\u73b0\u7684\u95ee\u9898",
  "support.report.body": "\u901a\u8fc7\u9875\u9996 GitHub \u4ed3\u5e93\u5165\u53e3\u8fdb\u5165 Issues\u3002\u8bf7\u63d0\u4f9b Talkless \u7248\u672c\u53ca\u6784\u5efa\u53f7\u3001macOS \u7248\u672c\u3001Mac \u578b\u53f7\u3001\u8bc6\u522b\u5f15\u64ce\u3001\u9ea6\u514b\u98ce\uff0c\u4ee5\u53ca\u6e05\u6670\u7684\u590d\u73b0\u6b65\u9aa4\uff0c\u5e76\u8bf4\u660e\u9884\u671f\u884c\u4e3a\u4e0e\u5b9e\u9645\u7ed3\u679c\u3002\u672c\u7f51\u7ad9\u4e0d\u6536\u96c6\u6216\u63d0\u4ea4\u95ee\u9898\u53cd\u9988\u3002",
  "support.report.diagnostics": "\u5982\u9700\u8bca\u65ad\u4fe1\u606f\uff0c\u53ef\u5728\u201c\u8bbe\u7f6e \u2192 \u7cfb\u7edf \u2192 \u8bca\u65ad\u201d\u5bfc\u51fa\u672c\u5730 ZIP\u3002\u9644\u52a0\u524d\u8bf7\u5148\u68c0\u67e5\u5185\u5bb9\uff1b\u53ef\u9009\u7684\u5d29\u6e83\u62a5\u544a\u53ef\u80fd\u5305\u542b\u4e2a\u4eba\u4fe1\u606f\u4e0e\u8def\u5f84\u3002\u4fe1\u606f\u4e0d\u4f1a\u81ea\u52a8\u4e0a\u4f20\uff0c\u8bf7\u907f\u514d\u5206\u4eab\u79c1\u4eba\u542c\u5199\u6216\u9009\u4e2d\u6587\u5b57\u3002",
  "release.note.0": "\u8bbe\u7f6e\u5f15\u5bfc\u589e\u52a0\u53ef\u9009\u7684\u201c\u767b\u5f55\u65f6\u542f\u52a8\u201d\uff0c\u4e0e\u7cfb\u7edf\u8bbe\u7f6e\u9875\u5171\u7528\u540c\u4e00\u9879 macOS \u767b\u5f55\u9879\u8bbe\u7f6e\uff0c\u4e0d\u4f1a\u81ea\u52a8\u5f00\u542f\u3002"
}
